<Window x:Class="DolgozatWPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DolgozatWPF"
        mc:Ignorable="d"
        Title="Dolgozatok" Height="450" Width="650">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="4*"/>
            <RowDefinition Height="1*"/>
            <RowDefinition Height="1*"/>
        </Grid.RowDefinitions>
        <DataGrid x:Name="dgDolgozatok" 
                  Grid.Row="0" 
                  AutoGenerateColumns="False" 
                  CanUserAddRows="False"
                  HeadersVisibility="Column"
                  GridLinesVisibility="All"
                  Background="White"
                  FontSize="14">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Nev" Binding="{Binding Nev}" Width="150"/>
                <DataGridTextColumn Header="Eletkor" Binding="{Binding Eletkor}" Width="80"/>
                <DataGridTextColumn Header="Pontszam" Binding="{Binding Pontszam}" Width="90"/>
            </DataGrid.Columns>
        </DataGrid>
        <StackPanel Grid.Row="1" Orientation="Horizontal" VerticalAlignment="Center">
            <TextBlock Text="Név:" VerticalAlignment="Center" FontSize="14" Margin="0,0,10,0"/>
            <TextBox x:Name="txtNev" Width="180" Height="28" VerticalContentAlignment="Center" FontSize="14" Margin="0,0,25,0"/>
            <TextBlock Text="Életkor:" VerticalAlignment="Center" FontSize="14" Margin="0,0,10,0"/>
            <TextBox x:Name="txtEletkor" Width="60" Height="28" VerticalContentAlignment="Center" FontSize="14" Margin="0,0,25,0"/>
            <TextBlock Text="Pontszám:" VerticalAlignment="Center" FontSize="14" Margin="0,0,10,0"/>
            <TextBox x:Name="txtPontszam" Width="60" Height="28" VerticalContentAlignment="Center" FontSize="14"/>
        </StackPanel>
        <StackPanel Grid.Row="2" Orientation="Horizontal" VerticalAlignment="Center">
            <Button x:Name="btnHozzaadas" Content="Hozzáadás" Width="130" Height="38" FontSize="14" Margin="0,0,15,0" Click="btnHozzaadas_Click"/>
            <Button x:Name="btnMentes" Content="Mentés" Width="130" Height="38" FontSize="14" Click="btnMentes_Click"/>
        </StackPanel>
    </Grid>
</Window>
